#!/bin/bash

if ! xz --version > /dev/null 2> /dev/null; then
  echo "Cannot find \`xz\` command" >&2
  exit 2
fi

usage() {
  echo "Usage: $0 <files> ..." >&2
  exit 3
}

fileExists() {
  if [ ! -r "$1" ]; then
    echo "Argument \"$1\" must be a readable file" >&2
    exit 4
  fi
}

# Prints a count of bytes of a compressed files
compSize() {
  cat "$@" | xz --format=raw --compress --stdout --no-warn --quiet | wc -c
}

FILES_COUNT="$#"

if [ "$FILES_COUNT" == "0" ] || [ "$FILES_COUNT" == "1" ] && [ "$1" == "--help" ]; then
  usage
fi

FILES=("$@")

for file in "${FILES[@]}"; do
  fileExists "$file" || exit
done

declare -a individual_lens
for file in "${FILES[@]}"; do
  individual_lens+=("$(compSize "$file")")
done
individual_min=${individual_lens[0]}
individual_max=${individual_lens[0]}
for n in "${individual_lens[@]}"; do
  ((n < individual_min)) && individual_min=$n
  ((n > individual_max)) && individual_max=$n
done
unset individual_lens

all_lens="$(compSize "${FILES[@]}")"

relative_lens_sum=0
for ((oi = 0; oi < FILES_COUNT; ++oi)); do

  files_but_one=()
  if ((oi >= 1)); then
    files_but_one+=("${FILES[@]::$oi}")
  fi
  if ((oi + 1 < FILES_COUNT)); then
    files_but_one+=("${FILES[@]:(($oi+1))}")
  fi

  all_but_one_lens="$(compSize "${files_but_one[@]}")"
  relative_lens="$((all_lens - all_but_one_lens))"
  relative_lens_sum="$((relative_lens_sum + relative_lens))"
done

{
echo "individual_min: $individual_min"
echo "individual_max: $individual_max"
echo "relative_lens_sum: $relative_lens_sum"
echo
} >&2

echo "
scale=10
$relative_lens_sum / ($FILES_COUNT * $individual_max)
" | bc
